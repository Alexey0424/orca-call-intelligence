# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — copy to .env and fill in HF_TOKEN before first start:
#
#      cp .env.example .env
#
#  Everything else works out of the box for a local demo stack.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────────────
# Local demo credentials. The single container hosts two databases:
# `orca` (app data, auto-created) and `n8n` (n8n's own state, from POSTGRES_DB).
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=n8n

# ── n8n ───────────────────────────────────────────────────────────────────────
# Used to encrypt credentials at rest in the n8n DB. Any string works for a
# local demo; change both for anything beyond that.
N8N_ENCRYPTION_KEY=super-secret-key
N8N_USER_MANAGEMENT_JWT_SECRET=even-more-secret
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ── Ollama transport (host:port; docker-compose adds the http:// prefix) ──────
OLLAMA_HOST=ollama:11434

# ── Hugging Face ──────────────────────────────────────────────────────────────
# REQUIRED. pyannote speaker diarization is a gated model: create a free
# token at https://huggingface.co/settings/tokens and accept the licence at
#   https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_put_your_token_here

# ─────────────────────────────────────────────────────────────────────────────
#  call-analysis-api models — swap models by editing these (or live from the
#  control UI at http://localhost:8040, no restart needed for Ollama models)
# ─────────────────────────────────────────────────────────────────────────────

# ── ASR — Whisper via faster-whisper/CTranslate2 (English-only deployment) ────
# base | small | medium | large-v3
WHISPER_MODEL_ID=base
WHISPER_COMPUTE=float16

# ── Diarization (pyannote 3.1) ────────────────────────────────────────────────
DIARIZATION_MODEL_ID=pyannote/speaker-diarization-3.1

# ── Text sentiment (English RoBERTa, 3-class) ─────────────────────────────────
SENTIMENT_MODEL_ID=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_BATCH_SIZE=32

# ── Speech emotion (emotion2vec+ large, 9-class) ──────────────────────────────
SER_MODEL_ID=iic/emotion2vec_plus_large
SER_BATCH_SIZE=8
SER_SEGMENT_CAP=30

# ── Prosody / paralinguistics (eGeMAPS-v02 via openSMILE) ─────────────────────
MAX_PROSODY_SECONDS=300

# ── Entity extraction (GLiNER multilingual, zero-shot) ────────────────────────
NER_MODEL_ID=urchade/gliner_multi-v2.1
NER_THRESHOLD=0.45

# ── LLM (Ollama) — KPI extraction + coaching rubric + n8n chat agent ─────────
LLM_MODEL_ID=gemma4:e4b
# 600s covers the first-request cold load of the model into VRAM. Once warm,
# the KPI call itself finishes in 20-40 s.
LLM_TIMEOUT_SEC=600
LLM_NUM_CTX=16384
LLM_NUM_PREDICT=4096

# ── LLM opening speaker→role relabel ─────────────────────────────────────────
# Fixes diarization's cold-start role mislabel by reading the opening
# transcript. qwen2.5:14b won the eval for this task (client recall 1.0);
# the KPI model is the in-code retry fallback. The same model also powers
# the bundled n8n chat agent (gemma4's reasoning mode breaks n8n's Tools
# Agent), so this pull is required.
OPENING_RELABEL_ENABLED=1
OPENING_RELABEL_MODEL=qwen2.5:14b-instruct-q4_K_M

# ── Embeddings (Ollama + Matryoshka MRL 2560 → 1024 truncation) ───────────────
EMBEDDING_MODEL_ID=qwen3-embedding:4b
EMBEDDING_NATIVE_DIM=2560
EMBEDDING_DIM=1024
# -1 = auto-fit (GPU when there's room; CPU fallback). 0 = force CPU.
EMBEDDING_NUM_GPU=-1

# ─────────────────────────────────────────────────────────────────────────────
#  render-api (per-call PDF + dashboard HTML)
# ─────────────────────────────────────────────────────────────────────────────
SER_RENDER_OUTPUT_DIR=/data/reports
SER_RENDER_PUBLIC_BASE_URL=http://localhost:8010
REPORT_COMPANY_NAME=ORCA Executive Call Review
REPORT_BRAND_COLOR=#1a3c34
REPORT_ACCENT_COLOR=#c9a84c

# ─────────────────────────────────────────────────────────────────────────────
#  Dashboard branding (rag-api → render-api template vars)
# ─────────────────────────────────────────────────────────────────────────────
BRAND_MARK=O
BRAND_NAME=ORCA
BRAND_SUB=Call Intelligence
BRAND_FOOTER_LEFT=ORCA · Call Intelligence Report
BRAND_FOOTER_RIGHT=Powered by ORCA
